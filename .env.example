APP_NAME="PCC-EDMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pcc_edms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DOCUMENTS_DISK_DRIVER=local
QUEUE_CONNECTION=database

# docs/architecture.md ADR-005 — path to a local Chrome/Chromium binary for Browsershot PDF
# generation, and the node_modules directory containing the `puppeteer` package.
PDF_CHROME_PATH=
PDF_NODE_MODULE_PATH=

# Certificate signatories — names/titles printed on generated certificates. All optional;
# defaults in config/rec.php and config/pdf.php match the current office holders.
# Full guide: docs/SIGNATORIES.md
#REC_CHAIR_NAME="Dr. Perlita R. Antonio"
#REC_CHAIR_TITLE="Chair, Institutional Research Ethics Committee"
#REC_MEMBER_NAME="Dr. Antonio L. Cruz"
#REC_MEMBER_TITLE="Member, Institutional Research Ethics Committee/ORD"
#EVP_NAME="Dr. Jennifer S. Apolinario"
#EVP_TITLE="Executive Vice President"
#EVP_SIGNATURE_PATH="images/signatures/evp.png"
#DPO_OFFICER_TITLE="DPO Officer"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
